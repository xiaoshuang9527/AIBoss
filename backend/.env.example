# ============================================================
# 智能求职辅助工作台 · 后端配置示例
# 复制为 .env 后按需修改。所有变量均可用 BZP_ 前缀覆盖。
# ============================================================

# ---------- 基础 ----------
BZP_APP_NAME=智能求职辅助工作台
BZP_DEBUG=false
BZP_HOST=0.0.0.0
BZP_PORT=8000
# 前端开发服务器地址，用于 CORS
BZP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# 默认 SQLite，开箱即用；生产建议 PostgreSQL 或 MySQL
# PostgreSQL: postgresql+asyncpg://boss:boss@localhost:5432/boss_workbench
# MySQL:      mysql+aiomysql://boss:boss@localhost:3306/boss_workbench
BZP_DATABASE_URL=sqlite+aiosqlite:///./storage/boss_workbench.db
BZP_DB_ECHO=false

# ---------- 数据与登录态目录 ----------
# 相对路径按 backend/ 解析，绝对路径原样使用
BZP_STORAGE_ROOT=./storage
# 爬虫（boss-zhipin-scraper）源码目录
BZP_SCRAPER_DIR=../boss-zhipin-scraper
# 执行爬虫所用的 Python 解释器，留空则使用当前解释器
BZP_SCRAPER_PYTHON=
# CDP 调试端口
BZP_CDP_PORT=9222
# 单个抓取任务超时（秒）
BZP_TASK_TIMEOUT_SECONDS=1800
# 授权（扫码登录）等待超时（秒）
BZP_AUTH_TIMEOUT_SECONDS=300

# ---------- 队列与并发 ----------
# 同时执行的最大爬虫任务数（建议 1~2，过高会触发风控）
BZP_MAX_CONCURRENT_TASKS=2
# 任务之间的随机延迟区间（秒）
BZP_TASK_DELAY_MIN=3
BZP_TASK_DELAY_MAX=5
# 失败自动重试次数
BZP_MAX_RETRIES=1
# 单次任务最大页数硬上限（防误操作触发风控）
BZP_MAX_PAGES_PER_TASK=10

# ---------- 风控与合规 ----------
# 单次任务全局请求预算（与爬虫内部预算一致的软提示）
BZP_REQUEST_BUDGET=500
# 免责声明文案（显示在前端显著位置）
BZP_DISCLAIMER=本工具仅供个人学习与求职分析使用，数据来源于公开职位页面，严禁用于商业倒卖或大规模抓取。请务必控制抓取频率，遵守目标网站用户协议。

# ---------- 登录态加密 ----------
# 用于加密存储 Cookie / Local State 的密钥。
# 生产环境务必修改：python -c "import secrets;print(secrets.token_urlsafe(32))"
BZP_SECRET_KEY=CHANGE_ME_please_generate_a_random_key

# ---------- AI 对话 ----------
# 用假模型 echo 驱动对话：不访问真实 LLM API，用于调试前端交互。
# 生产必须为 false，否则 AI 回复会是模拟内容。
BZP_FAKE_LLM=false
# 单次回复的最大输出 token
BZP_CHAT_MAX_TOKENS=2048
# 附件大小与数量限制（与前端校验保持一致）
BZP_CHAT_MAX_IMAGE_BYTES=8388608
BZP_CHAT_MAX_DOC_BYTES=20971520
BZP_CHAT_MAX_ATTACHMENTS=5

# ---------- 定时维护 ----------
# 定时把超时未结束的任务标记为失败（秒），0 表示关闭
BZP_STALE_TASK_SCAN_SECONDS=120
