# ============================================================
# 依赖与构建产物
# ============================================================
node_modules/
dist/
.venv*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# 本地配置与运行时数据
# ============================================================
# 含密钥的本地配置：只提交 .env.example
backend/.env
.env
.env.local

# 运行时数据：数据库、日志、隔离浏览器 profile、登录态
backend/storage/
storage/

# 构建/包管理缓存
.npm-cache/
.esbuild-tmp/
.tmp/

# pytest 的临时目录。
# 测试里用 tmp_path 造的文件会落在 <cwd>/pytest-of-<user>/ 下，
# 放在 backend/ 里很容易被 git add -A 顺手带进提交（曾经真的提交过一次）。
pytest-of-*/
backend/pytest-of-*/

# ============================================================
# 编辑器与系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================
# 兜底：任何位置都不要提交日志与调试残留
# ============================================================
*.log
backend/bzp-*/
